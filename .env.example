# ---------------------------------------------------------------------------
# Copy to .env and fill in. .env is git-ignored: no real connection string,
# project id or account address belongs in this repository.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------

# Local development:
#   docker run --rm -p 5432:5432 -e POSTGRES_PASSWORD=postgres postgres:16-alpine
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# On Cloud Run the built-in Cloud SQL connector exposes a unix socket:
#   DATABASE_URL=postgres://APP_ROLE:PASSWORD@/DB_NAME?host=/cloudsql/PROJECT:REGION:INSTANCE
# The socket handles TLS, so leave DATABASE_SSL=false there.
DATABASE_SSL=false

# Least-privilege login role the SERVER connects as. Only the migration tooling
# needs this: it grants that role row access and nothing more.
#
# CRITICAL: it must NOT be a superuser and must not hold BYPASSRLS. PostgreSQL
# exempts both from row-level security unconditionally, so pointing the server at
# the `postgres` user turns ledger isolation off entirely -- one household would
# be served the other's private data with no error anywhere.
#
# The server refuses to start if it detects such a role, but do not rely on that
# as the design: run migrations as the owner, run the server as this role.
#
# Leave unset locally to skip the grant step.
# DATABASE_APP_ROLE=app_user

# --- Server ----------------------------------------------------------------

# Cloud Run supplies PORT; 8080 is its default contract.
PORT=8080
NODE_ENV=development

# 'iap' verifies Identity-Aware Proxy's signed assertion (deployed).
# 'dev' trusts an X-Dev-User-Email header and REFUSES to start when
# NODE_ENV=production.
AUTH_MODE=dev

# The `aud` claim IAP mints for THIS service; copy it from the service's IAP
# settings. Required when AUTH_MODE=iap. Checking it is what stops an assertion
# issued for another IAP-protected service being replayed here.
# IAP_AUDIENCE=/projects/PROJECT_NUMBER/locations/LOCATION/services/SERVICE_NAME

# Comma-separated addresses allowed to create an account on first sign-in.
#
# This is the second gate, not the first: IAP's IAM policy decides who reaches
# the service at all. It is also NOT a revocation list -- an established user is
# recognised by their Google subject id regardless of what this says, so that
# changing a Google address does not lock someone out of their own data.
# To revoke access, remove the person from the IAP IAM policy.
ALLOWED_EMAILS=you@example.com,partner@example.com

# Display name of the ledger both members share.
SHARED_LEDGER_NAME=家計

# Built client assets, served by the Node process.
STATIC_DIR=dist/client

# Apply pending migrations at start-up (guarded by an advisory lock).
MIGRATE_ON_START=false

# --- Local development only ------------------------------------------------

# Identity the Vite dev proxy claims when AUTH_MODE=dev. Must appear in
# ALLOWED_EMAILS for the first sign-in to provision an account.
DEV_USER_EMAIL=you@example.com
