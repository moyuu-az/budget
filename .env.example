# ---------------------------------------------------------------------------
# Copy to .env and fill in. .env is git-ignored: no real connection string,
# project id or account address belongs in this repository.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------

# Local development (docker run --rm -p 5432:5432 -e POSTGRES_PASSWORD=postgres postgres:16-alpine)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# On Cloud Run, the built-in Cloud SQL connector exposes a unix socket instead:
#   DATABASE_URL=postgres://APP_ROLE:PASSWORD@/DB_NAME?host=/cloudsql/PROJECT:REGION:INSTANCE
# The socket path means TLS is already handled, so leave DATABASE_SSL=false.
DATABASE_SSL=false

# Least-privilege login role the SERVER uses. Migrations run as the database
# owner and grant this role row-level access only.
#
# Critical: this must NOT be a superuser and must not hold BYPASSRLS.
# PostgreSQL exempts both from row-level security unconditionally -- pointing
# the server at the `postgres` user turns every isolation policy off.
#
# Leave unset locally to skip the grant step.
# DATABASE_APP_ROLE=app_user
