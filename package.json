{
  "name": "balance-forecast",
  "version": "1.0.0",
  "description": "Balance Forecast — 共有/個人の家計簿を扱う Web アプリ",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:web": "vitest run --project web",
    "test:server": "vitest run --project server",
    "test:coverage": "vitest run --coverage",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "typecheck": "tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:import": "tsx scripts/import-sqlite.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moyuu-az/budget.git"
  },
  "keywords": [],
  "author": "moyuu-az",
  "license": "ISC",
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@types/three": "^0.182.0",
    "d3-sankey": "^0.12.3",
    "d3-shape": "^3.2.0",
    "dotenv": "^17.4.2",
    "framer-motion": "^12.33.0",
    "google-auth-library": "^11.0.2",
    "hono": "^4.13.3",
    "pg": "^8.23.0",
    "react": "^19.2.4",
    "react-countup": "^6.5.3",
    "react-dom": "^19.2.4",
    "recharts": "^3.7.0",
    "three": "^0.182.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.4.2",
    "@storybook/addon-docs": "^10.4.2",
    "@storybook/react-vite": "^10.4.2",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/vite": "^4.1.18",
    "@testcontainers/postgresql": "^12.1.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/d3-sankey": "^0.12.5",
    "@types/d3-shape": "^3.1.8",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.3",
    "@vitest/coverage-v8": "^3.2.6",
    "autoprefixer": "^10.4.24",
    "concurrently": "^10.0.5",
    "happy-dom": "^15.11.7",
    "postcss": "^8.5.6",
    "storybook": "^10.4.2",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^3.2.6"
  },
  "type": "commonjs"
}
