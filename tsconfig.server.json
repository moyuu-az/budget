{
  "// note": "Build-only config: emits the server to dist/. Type CHECKING still runs through tsconfig.node.json, which also covers scripts and tests.",
  "extends": "./tsconfig.node.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "./dist",
    "rootDir": ".",
    "noEmit": false,
    "declaration": false,
    "sourceMap": true
  },
  "include": ["server/**/*.ts", "shared/**/*.ts"],
  "exclude": ["**/*.test.ts", "**/*.spec.ts", "server/test/**"]
}
